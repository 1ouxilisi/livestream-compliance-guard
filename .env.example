# ============================================================
# livestream-compliance-guard 环境变量样例
# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略，绝不提交。
# 规则核心 v1 零外部依赖、零密钥即可运行：python server.py --selftest
# 下列变量仅在 P1 接入 LLM 增强层 / 远程部署时才需要。
# ============================================================

# 国内模型聚合（OpenAI 兼容接口，一个 key 调多家开源模型，有免费模型）
SILICONFLOW_API_KEY=

# 魔搭 ModelScope（开发期免费开源模型推理 / OpenAPI）
MODELSCOPE_API_KEY=

# 海外多模型聚合（P2，跨境版）
OPENROUTER_API_KEY=

# 模型路由（PRIMARY 与 FALLBACK 至少填一个，否则即使有 key 也判 no_model、降级纯规则）
# 硅基流动实测（OpenAI 兼容、需支持 response_format=json_object）：
#   主力推荐 Qwen/Qwen3-14B（谐音/暗示类语义召回准）；兜底 deepseek-ai/DeepSeek-V3（快、稳、省）
#   注意：Qwen/Qwen3-8B 会漏判“薇芯”类谐音导流；zai-org/GLM-4.5-Air 不支持 JSON mode；Qwen3.5-9B 思考易超时
LCG_MODEL_PRIMARY=
LCG_MODEL_FALLBACK=

# LLM 语义层（scan_smart / rewrite_smart）开关与预算
# 不填任何模型 key 时自动降级 mode=rules_only，服务照常；填 key 后启用语义检测与自然改写
LCG_LLM_ENABLED=1
LCG_LLM_PROVIDER=siliconflow
# LCG_LLM_BASE_URL=        # 可选：自定义 OpenAI 兼容端点
# LCG_LLM_API_KEY=         # 可选：通用 key（不设则按 PROVIDER 取上面的专用 key）
LCG_LLM_TIMEOUT=20
LCG_LLM_MAX_CALLS=200

# 成本估算单价（每百万 token，币种随 provider 账单；留 0 或不填则基准报告只汇总 token 量、不报金额）
# LCG_PRICE_INPUT_PER_MTOK=2.5
# LCG_PRICE_OUTPUT_PER_MTOK=8.0

# 远程 MCP（Streamable HTTP）已内置：python -m lcg.server_http
# 设置 LCG_BEARER_TOKEN 后，除 /healthz 外所有请求必须带 Authorization: Bearer <token>；
# 不设置则本地开放（仅限可信内网/本机），公网部署务必设置。
LCG_BEARER_TOKEN=
LCG_HTTP_HOST=0.0.0.0
LCG_HTTP_PORT=8000

# 部署平台：Cloudflare / Railway / 腾讯云 等在各自控制台也用 Secret 注入，勿写进仓库
